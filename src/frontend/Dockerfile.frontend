# ==============================================================================
# Dockerfile.frontend - Interface Opérateur Streamlit - Support Produit Nexus
# ==============================================================================

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Définition du répertoire de travail applicatif
WORKDIR /app

# Optimisation uv : compilation du bytecode et copie des fichiers dans l'image
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Copie des fichiers de verrouillage et de métadonnées Python
COPY pyproject.toml uv.lock ./

# Installation déterministe des dépendances de production via uv
RUN uv sync --frozen --no-dev --no-install-project

# Copie du code source
COPY src/ ./src/
RUN mkdir -p /app/logs

# Exécution sous un utilisateur non-privilégié (durcissement sécurité Docker)
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

# Exposition du port web Streamlit
EXPOSE 8000

# Démarrage de l'interface Streamlit via uv run
CMD ["uv", "run", "--no-dev", "streamlit", "run", "src/frontend/app.py", "--server.address", "0.0.0.0", "--server.port", "8000", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
