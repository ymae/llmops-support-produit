# ===============================================================
# Configuration Environnement - Support Produit Nexus Platform
# ================================================================

# --- 1. Fournisseur LLM Externe (Groq via LiteLLM Proxy) ---
GROQ_API_KEY=gsk_votre_cle_groq_ici
GROQ_MODEL_NAME=groq/openai/gpt-oss-20b
LITELLM_MASTER_KEY=sk-nexus-litellm-master-key-v1
LITELLM_PROXY_URL=http://litellm-proxy:4000/v1
LITELLM_MODEL_NAME=nexus-support-llm

# --- 2. Sécurité API Backend (FastAPI HTTPBearer & JWT HS256) ---
API_SECRET_TOKEN=nexus-v1-secret-bearer-token-2026
JWT_SECRET_KEY=nexus-v1-jwt-hs256-secret-key-2026-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BACKEND_API_URL=http://backend-api:8080

# --- 3. Authentification Opérateurs Frontend (Chainlit) ---
# Générer un secret fort via : chainlit create-secret
CHAINLIT_AUTH_SECRET=nexus-chainlit-auth-secret-key-v1-2026-change-me
AGENT_USERNAME=agent
AGENT_PASSWORD=agent-pass
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager-pass

# --- 4. Observabilité Niveau 1 : Logger JSON Structuré Local ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.jsonl

# --- 5. Observabilité Niveau 2 : Langfuse Auto-Hébergé Local ---
# Par défaut en local : http://localhost:3000 (surchargé par http://langfuse-server:3000 dans Docker)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-local-nexus
LANGFUSE_SECRET_KEY=sk-lf-local-nexus
LANGFUSE_HOST=http://localhost:3000

# --- 6. Infrastructure Langfuse Self-Hosted (Docker Compose : langfuse-server + langfuse-db) ---
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse-local-db-pass
POSTGRES_DB=langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:langfuse-local-db-pass@langfuse-db:5432/langfuse
NEXTAUTH_SECRET=nexus-langfuse-local-nextauth-secret-2026
NEXTAUTH_URL=http://localhost:3000
SALT=nexus-langfuse-local-salt-2026
LANGFUSE_INIT_ORG_ID=nexus-org
LANGFUSE_INIT_ORG_NAME=Nexus Platform
LANGFUSE_INIT_PROJECT_ID=nexus-support-v1
LANGFUSE_INIT_PROJECT_NAME=Support Produit Nexus
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-nexus
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-nexus
LANGFUSE_INIT_USER_EMAIL=admin@nexus-local.internal
LANGFUSE_INIT_USER_NAME=Nexus Admin
LANGFUSE_INIT_USER_PASSWORD=nexus-admin-local-pass
